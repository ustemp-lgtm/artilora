<script setup>
useHead({
  title: 'Gallery - Artilora',
  meta: [
    { name: 'description', content: 'Explore Artilora\'s gallery of organic sculptures. Each piece reveals the hidden beauty within nature through mindful meditation and artistic presence.' },
