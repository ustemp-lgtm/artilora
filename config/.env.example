# Google Analytics Configuration
# Get your Measurement ID from: https://analytics.google.com
# It looks like: G-XXXXXXXXXX
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Instructions:
# 1. Copy this file and rename it to: .env
# 2. Replace G-XXXXXXXXXX with your actual Google Analytics Measurement ID
# 3. Restart Docker: .\docker-restart.ps1
